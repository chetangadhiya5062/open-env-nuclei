# Copy to .env (never commit .env). All values are read from environment variables.

# --- LLM agent (Hugging Face router, OpenAI-compatible) ---
HF_TOKEN=your_huggingface_token_here
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# --- Environment server ---
# Port the server listens on (Hugging Face Spaces expects 7860)
PORT=7860
# Where clients (inference.py, benchmark.py) find the server
ENV_URL=http://localhost:7860
